rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global lock
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    
    // User validation
    function isValidUserConfig(data) {
      return data.keys().hasOnly(['name', 'district', 'phone', 'activeSessions', 'id', 'customMessage'])
        && ( !('name' in data) || (data.name is string && data.name.size() <= 100) )
        && ( !('district' in data) || (data.district is string && data.district.size() <= 100) )
        && ( !('phone' in data) || (data.phone is string && data.phone.size() <= 20) )
        && ( !('activeSessions' in data) || (data.activeSessions is list && data.activeSessions.size() <= 10) )
        && ( !('id' in data) || (data.id is string && data.id.size() <= 128) )
        && ( !('customMessage' in data) || (data.customMessage is string && data.customMessage.size() <= 1000) );
    }

    match /users/{userId} {
      allow get, list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() 
        && isOwner(userId) 
        && isValidId(userId)
        && isValidUserConfig(incoming());
      allow update: if isSignedIn() 
        && isOwner(userId)
        && isValidUserConfig(incoming());
      
      // Events subcollection
      match /events/{eventId} {
        function isValidEvent(data) {
          return data.userId == request.auth.uid;
        }

        allow get, list: if isSignedIn() && isOwner(userId);
        
        allow create: if isSignedIn() 
          && isOwner(userId) 
          && isValidId(eventId)
          && isValidEvent(incoming());

        allow update: if isSignedIn() 
          && isOwner(userId)
          && isValidEvent(incoming());

        allow delete: if isSignedIn() && isOwner(userId);
      }
    }
  }
}
